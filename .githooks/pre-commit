#!/bin/sh
set -e
bun typecheck

# Check the staged files without --write. Writing here would change the working
# tree but not the index, so the commit would record the unformatted content.
if ! bun x biome check --staged --files-ignore-unknown=true --no-errors-on-unmatched; then
  echo >&2
  echo "[pre-commit] FAILED: biome found lint or format errors in staged files." >&2
  echo "[pre-commit] Run 'bun run lint:fix', review the changes, stage them, and commit again." >&2
  exit 1
fi
