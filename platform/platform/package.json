{
  "name": "@di-framework/platform",
  "version": "6.0.1",
  "description": "Shared Pulumi infrastructure for DI Framework wasmCloud platforms.",
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "license": "(MIT OR Apache-2.0)",
  "repository": {
    "type": "git",
    "url": "https://github.com/di-framework/platform",
    "directory": "platform/platform"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./local": {
      "types": "./dist/local.d.ts",
      "default": "./dist/local.js"
    },
    "./existing": {
      "types": "./dist/existing.d.ts",
      "default": "./dist/existing.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "bun test"
  },
  "dependencies": {
    "@pulumi/command": "1.2.1",
    "@pulumi/kubernetes": "4.34.0",
    "@pulumi/pulumi": "3.261.0"
  },
  "devDependencies": {
    "@types/node": "26.1.2"
  },
  "typesVersions": {
    "*": {
      "local": [
        "dist/local.d.ts"
      ],
      "existing": [
        "dist/existing.d.ts"
      ]
    }
  },
  "bugs": {
    "url": "https://github.com/di-framework/platform/issues"
  },
  "homepage": "https://github.com/di-framework/platform"
}
