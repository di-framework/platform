{
  "name": "@di-framework/platform",
  "version": "6.0.17",
  "description": "Shared Pulumi infrastructure for DI Framework wasmCloud platforms.",
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "license": "(MIT OR Apache-2.0)",
  "repository": {
    "type": "git",
    "url": "https://github.com/di-framework/platform",
    "directory": "platform/platform"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./local": {
      "types": "./dist/local.d.ts",
      "default": "./dist/local.js"
    },
    "./existing": {
      "types": "./dist/existing.d.ts",
      "default": "./dist/existing.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && bun ../../scripts/fix-esm-imports.ts dist",
    "test": "bun test"
  },
  "dependencies": {
    "@kubernetes/client-node": "2.0.0",
    "@pulumi/command": "1.2.1",
    "@pulumi/kubernetes": "4.34.2",
    "@pulumi/pulumi": "3.268.0",
    "js-yaml": "5.5.0"
  },
  "devDependencies": {
    "@marcbachmann/cel-js": "^8.0.0",
    "@types/node": "26.6.5"
  },
  "typesVersions": {
    "*": {
      "local": [
        "dist/local.d.ts"
      ],
      "existing": [
        "dist/existing.d.ts"
      ]
    }
  },
  "bugs": {
    "url": "https://github.com/di-framework/platform/issues"
  },
  "homepage": "https://github.com/di-framework/platform"
}
