{
  "name": "@di-framework/tenant-cli",
  "version": "6.0.24",
  "private": false,
  "type": "module",
  "license": "(MIT OR Apache-2.0)",
  "description": "Pilot tenant CLI: talks only to the tenant controller's OpenAPI contract with an identity-server credential; never to Kubernetes.",
  "repository": {
    "type": "git",
    "url": "https://github.com/di-framework/platform",
    "directory": "platform/tenant-cli"
  },
  "homepage": "https://github.com/di-framework/platform",
  "files": [
    "dist",
    "src/api",
    "api/v1/openapi.yaml",
    "README.md",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "exports": {
    "./client": {
      "types": "./dist/client/index.d.ts",
      "bun": "./dist/client/index.js",
      "import": "./dist/client/index.js",
      "default": "./dist/client/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "bun": "./dist/testing/index.js",
      "import": "./dist/testing/index.js",
      "default": "./dist/testing/index.js"
    },
    "./src/api/*": "./src/api/*",
    "./package.json": "./package.json"
  },
  "bin": {
    "di-tenant": "dist/main.js"
  },
  "scripts": {
    "cli": "bun src/main.ts",
    "generate:api": "di-framework generate && bun scripts/generate-openapi.ts",
    "generate:client": "bun --no-install scripts/openapi-typescript.ts api/v1/openapi.yaml -o src/client/schema.d.ts",
    "generate": "bun run generate:api && bun run generate:client",
    "build": "rm -rf dist && bun x tsc -p tsconfig.build.json && cp src/client/schema.d.ts dist/client/schema.d.ts && bun ../../scripts/fix-esm-imports.ts dist",
    "test": "bun test"
  },
  "dependencies": {
    "@di-framework/core": "^6.1.0",
    "@di-framework/http": "^6.1.0"
  },
  "devDependencies": {
    "@typescript/typescript6": "^6.0.2",
    "openapi-typescript": "7.13.0"
  }
}
