{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": {
      "@pulumi/pulumi": ["./node_modules/@pulumi/pulumi"],
      "@pulumi/pulumi/*": ["./node_modules/@pulumi/pulumi/*"],
      "@pulumi/kubernetes": ["./node_modules/@pulumi/kubernetes"],
      "@pulumi/kubernetes/*": ["./node_modules/@pulumi/kubernetes/*"]
    }
  },
  "include": ["index.ts", "../src/install.ts"]
}
