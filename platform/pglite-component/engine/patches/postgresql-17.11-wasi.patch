+    }
+
+    if (!root_fs.statSync) {
+        // MISSING:
+        for (let line of `
+appendFileSync
+fsyncSync
+linkSync
+setFlagsSync
+mkdirSync
+readdirSync
+readFileSync
+readlinkSync
+renameSync
+rmdirSync
+statSync
+symlinkSync
+truncateSync
+unlinkSync
+utimesSync
+writeFileSync
