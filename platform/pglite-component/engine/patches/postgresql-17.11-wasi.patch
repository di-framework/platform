+  return typeof value === 'object'
+  && value !== null
+  && !Array.isArray(value)
+  && !(value instanceof RegExp)
+  && !(value instanceof Date)
+  && !(value instanceof Set)
+  && !(value instanceof Map)
+}
+
+const isMapping = (value) => {
+  return typeof value === 'object'
+  && value !== null
+  && !Array.isArray(value)
+  && !(value instanceof RegExp)
