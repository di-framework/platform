+        Module.vt = new WasmTerminal("repl", 200, 55, 16)
+
+        Module.bc = new BroadcastChannel("pglite")
+
+
+        const pg_lck = "/tmp/pglite/base/.s.PGSQL.5432.lock.in"
+        const pg_in = "/tmp/pglite/base/.s.PGSQL.5432.in"
+        const pg_out = "/tmp/pglite/base/.s.PGSQL.5432.out"
+
+        function send_to_pglite(encoded, FS, port) {
+            const count = encoded.byteLength
+            var buf
+            if (port<0) {
+                /* as socket file */
+                Module._interactive_write(0)
+                FS.writeFile(pg_lck, encoded)
+                FS.rename(pg_lck, pg_in)
+                console.log("send_to_pglite(sf):", count)
+                Module._interactive_one()
+                if (os.FS.analyzePath(pg_out).exists) {
+                    const fstat = FS.stat(pg_out)
+                    console.log("pgreply", fstat.size)
+                    var stream = FS.open(pg_out, 'r');
+                    buf = new Uint8Array(fstat.size);
+                    FS.read(stream, buf, 0, fstat.size, 0);
+                    FS.close(stream);
+                    FS.unlink(pg_out)
+                } else {
+                    console.log("REPL: no reply, see stdout", x)
+                }
+            } else {
+                /* CMA */
+                Module._interactive_write(count)
+                Module.HEAPU8.set(encoded, port)
+                console.log("send_to_pglite(cma):", count, "sent to", port)
+                Module._interactive_one()
+                const msg_start = count + 2
+                const msg_end = msg_start + Module._interactive_read()
+                buf = Module.HEAPU8.subarray(msg_start, msg_end)
+            }
+            //Module.bc.postMessage(buf)
+        }
+
+        Module.bc.onmessage = (ev) => {
+            const FS = Module.FS
+            //console.warn("bc.onmessage:", event)
+            if (ev.userData) {
+                var data = ev.userData["data"]
+                var encodedArray;
+                if (data.byteLength) {
+                    console.log("binary data, using wire")
+                    Module._use_wire(1)
+                    encodedArray.set(data)
+                } else {
+                    // console.log("string data, using repl/no wire")
+                    Module._use_wire(0)
+                    const encoder = new TextEncoder();
+                    encodedArray = encoder.encode(data);
+                }
+// sf
+//                send_to_pglite(encodedArray, FS, -1)
+// cma
+                send_to_pglite(encodedArray, FS, Module.cma_port || 1)
+            } else {
+                console.warn("BC(srv):", ev);
+            }
+
+        };
+
+
+#if MODULARIZE
+        if (is_es6) {
