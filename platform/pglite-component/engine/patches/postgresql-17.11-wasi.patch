+
+        if (stack.length) {
+            if (isMapping(stack[stack.length-1])) {
+                update(kw, stack.pop())
+            }
+        }
+        var argv= [bin]
+            argv.push(...stack)
+
+        var wasi = new wasm32_wasi_preview1({
+          fs: os.FS,
+          args: argv,
+          env: kw,
+        })
+
+        wasi.stdout = kw["stdout"] || ( (msg) => vm.vt.xterm.write(os.codec.decode(msg)+"\r") )
+        wasi.stderr = kw["stderr"] || ( (msg) => vm.vt.xterm.write('\x1B[1;3;31m' + os.codec.decode(msg) + "\x1B[0m\r") )
+
+        const exe = `bin/${bin}.wasm`
+        console.log("Loading wasi bin : ", bin, "from", exe, "in", vm )
+
+        // await os.FS.writeFile('/pg_dump', '\0', {mode:os.umask})
+        // await os.FS.writeFile('/tmp/pglite/base/.s.PGSQL.5432.lock.in', '\0', {mode:os.umask})
+
+        os.PATH[bin] = await WebAssembly.instantiateStreaming(fetch(exe), {wasi_snapshot_preview1:wasi})
+        var app= os.PATH[bin]
+            app.wasi = wasi
+            app.cmdline = exe+" "+ stack.join(' ')
+            app.codec = kw["encoding"] || os.codec
+        console.log(app)
+        var ec = 0
+        try {
+            ec = wasi.start(app.instance.exports)
+        } catch (x) {
+            console.trace()
+            console.warn("abnormal program termination", x)
+            const dv = new DataView(app.instance.exports.memory.buffer)
+            ec = dv.getUint8(0);
+        }
+        console.log(`${bin} ${wasi.args}  exit code = ${ec}`)
+        return ec
+    }
