.PHONY: build test vet generate chart-sync check

CRD := config/crd/platform.di-framework.dev_platforminstances.yaml
ROLE := config/rbac/role.yaml
CHART_CRD := chart/templates/crd.yaml
CHART_ROLE := chart/templates/clusterrole.yaml

build:
	CGO_ENABLED=0 go build -trimpath -o bin/platform-operator ./cmd/platform-operator

test:
	go test ./...

vet:
	go vet ./...

# Regenerates the DeepCopy methods, the CRD and the operator's ClusterRole from the API markers,
# then copies the CRD and the ClusterRole into the Helm chart.
generate:
	go tool controller-gen object paths=./api/...
	go tool controller-gen crd paths=./api/... output:crd:artifacts:config=config/crd
	go tool controller-gen rbac:roleName=platform-operator paths=./internal/controller/... output:rbac:artifacts:config=config/rbac
	$(MAKE) chart-sync

# The chart's CRD is config/crd with `helm.sh/resource-policy: keep` added, so `helm uninstall`
# leaves the CRD (and so every PlatformInstance) in place. It sits in templates/, not crds/,
# because Helm never upgrades CRDs in crds/. The ClusterRole is config/rbac verbatim. Both are
# rendered as templates, so a `{{` in either would be read as template syntax: refuse it.
chart-sync:
	@if grep -q '{{' $(CRD) $(ROLE); then echo "chart-sync: '{{' in $(CRD) or $(ROLE) would be read as Helm template syntax" >&2; exit 1; fi
	{ echo '# Generated by `make generate` from $(CRD). Do not edit.'; \
	  awk '{ print } /^  annotations:$$/ && !done { print "    helm.sh/resource-policy: keep"; done = 1 } END { if (!done) exit 1 }' $(CRD); } > $(CHART_CRD)
	{ echo '# Generated by `make generate` from $(ROLE). Do not edit.'; cat $(ROLE); } > $(CHART_ROLE)

# CI: generated files (the chart's copies among them) must match the markers, gofmt clean, vet
# and tests pass.
check: generate
	git diff --exit-code -- api config chart/templates
	git ls-files --error-unmatch $(CHART_CRD) $(CHART_ROLE) >/dev/null
	test -z "$$(gofmt -l .)"
	go vet ./...
	go test ./...
