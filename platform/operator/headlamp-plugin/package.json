{
  "name": "di-framework-platform",
  "version": "0.1.0",
  "description": "Headlamp plugin for di-framework PlatformInstances (platform.di-framework.dev/v1alpha1)",
  "private": true,
  "license": "(MIT OR Apache-2.0)",
  "repository": "https://github.com/di-framework/platform",
  "scripts": {
    "start": "headlamp-plugin start",
    "build": "headlamp-plugin build",
    "format": "headlamp-plugin format",
    "lint": "headlamp-plugin lint",
    "lint-fix": "headlamp-plugin lint --fix",
    "package": "headlamp-plugin build && node scripts/package.mjs",
    "tsc": "headlamp-plugin tsc",
    "test": "headlamp-plugin test"
  },
  "keywords": [
    "headlamp",
    "headlamp-plugin",
    "kubernetes",
    "di-framework"
  ],
  "prettier": "@headlamp-k8s/eslint-config/prettier-config",
  "eslintConfig": {
    "extends": [
      "@headlamp-k8s",
      "prettier",
      "plugin:jsx-a11y/recommended"
    ],
    "rules": {
      "simple-import-sort/imports": "off",
      "simple-import-sort/exports": "off"
    }
  },
  "overrides": {
    "typescript": "5.6.2"
  },
  "devDependencies": {
    "@kinvolk/headlamp-plugin": "0.14.0",
    "@types/js-yaml": "4.0.9",
    "ajv": "8.20.0",
    "js-yaml": "4.3.2",
    "tar": "7.5.22"
  }
}
