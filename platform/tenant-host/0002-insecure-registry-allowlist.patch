+/// The transport oci-client uses for a pull or push with `config`.
+///
+/// `insecure` wins and switches every registry to plain HTTP. Otherwise a
+/// non-empty `insecure_registries` allowlist keeps HTTPS for every registry
+/// except the listed ones (exact `host[:port]` match, see
+/// [`OciConfig::insecure_registries`]), and an empty one means HTTPS for all.
+fn client_protocol(config: &OciConfig) -> ClientProtocol {
+    if config.insecure {
+        ClientProtocol::Http
+    } else if config.insecure_registries.is_empty() {
+        ClientProtocol::Https
+    } else {
+        ClientProtocol::HttpsExcept(config.insecure_registries.clone())
+    }
 }
 
