+    /// Pulls `<127.0.0.1:port>/probe/component:1` against a loopback listener
+    /// built with `make_config(registry)` and reports what the client opened
+    /// the connection with: `"http"` for a plaintext request line, `"https"`
+    /// for a TLS ClientHello. The listener answers nothing, so the pull itself
+    /// fails; only the scheme the client picked is observed.
+    async fn first_connection_scheme(make_config: impl FnOnce(&str) -> OciConfig) -> &'static str {
+        use tokio::io::AsyncReadExt as _;
+
+        let listener = tokio::net::TcpListener::bind("127.0.0.1:0")
+            .await
+            .expect("bind a loopback listener");
+        let registry = format!("127.0.0.1:{}", listener.local_addr().unwrap().port());
+        let mut config = make_config(&registry);
+        config.timeout = Some(Duration::from_secs(5));
+        let reference = format!("{registry}/probe/component:1");
+
+        let accept = async move {
+            let (mut socket, _) = listener.accept().await.expect("accept the client");
+            let mut first = [0u8; 4];
+            socket
+                .read_exact(&mut first)
+                .await
+                .expect("read the first bytes");
+            first
+        };
+        let pull = pull_component(&reference, config, OciPullPolicy::Always);
+        let (first, pulled) = tokio::time::timeout(Duration::from_secs(30), async {
+            tokio::join!(accept, pull)
+        })
+        .await
+        .expect("the client connects to the probe listener");
+        assert!(pulled.is_err(), "the probe listener serves no image");
+
+        if first[0] == 0x16 {
+            "https"
+        } else if matches!(&first, b"GET " | b"HEAD" | b"POST" | b"PUT ") {
+            "http"
+        } else {
+            panic!("unrecognised first bytes {first:?}")
+        }
+    }
