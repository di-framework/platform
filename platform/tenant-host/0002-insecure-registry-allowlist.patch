+/// Parses one `--insecure-registry` / `WASH_INSECURE_REGISTRIES` entry.
+///
+/// The entry is compared verbatim with a reference's registry, so anything
+/// that could never match is refused here instead of silently falling back to
+/// HTTPS: it is trimmed, and an empty entry (e.g. from a trailing comma), a
+/// scheme prefix, a path, or embedded whitespace is an error.
+fn parse_insecure_registry(value: &str) -> Result<String, String> {
+    let entry = value.trim();
+    if entry.is_empty() {
+        return Err("empty registry entry; expected host[:port], e.g. localhost:5000".to_string());
+    }
+    if entry.contains("://") {
+        return Err(format!(
+            "'{entry}' has a scheme; expected host[:port] without one, e.g. localhost:5000"
+        ));
+    }
+    if entry.contains('/') || entry.chars().any(char::is_whitespace) {
+        return Err(format!(
+            "'{entry}' is not a registry host[:port]; remove any path or whitespace"
+        ));
+    }
+    Ok(entry.to_string())
+}
