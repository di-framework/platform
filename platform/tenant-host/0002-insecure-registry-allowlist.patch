+#[cfg(test)]
+mod insecure_registry_tests {
+    use super::HostCommand;
+    use clap::Parser;
+
+    /// Set only in the child process `parse` spawns; holds the arguments to
+    /// parse, separated by U+001F.
+    const CHILD_ARGS: &str = "WASH_TEST_INSECURE_REGISTRY_ARGS";
+    const ENV: &str = "WASH_INSECURE_REGISTRIES";
+    const PROBE: &str = "cli::host::insecure_registry_tests::insecure_registry_parse_probe";
+
+    #[derive(Debug, Parser)]
+    struct Cli {
+        #[command(flatten)]
+        host: HostCommand,
+    }
+
+    /// Parses `wash host <args>` with `WASH_INSECURE_REGISTRIES` set to `env`
+    /// (or unset) and returns the allowlist, or the parse error's message.
+    ///
+    /// The environment is process-global and this crate denies the `unsafe`
+    /// that `std::env::set_var` needs, so the parse runs in a child copy of
+    /// this test binary, given exactly the environment under test, that runs
+    /// only [`insecure_registry_parse_probe`].
+    fn parse(args: &[&str], env: Option<&str>) -> Result<Vec<String>, String> {
+        let mut child = std::process::Command::new(std::env::current_exe().unwrap());
+        child
+            .args([PROBE, "--exact", "--nocapture", "--test-threads=1"])
+            .env(CHILD_ARGS, args.join("\u{1f}"))
+            .env_remove(ENV);
+        if let Some(value) = env {
+            child.env(ENV, value);
+        }
+        let output = child.output().expect("run the parse probe");
+        let stdout = String::from_utf8_lossy(&output.stdout);
+        assert!(output.status.success(), "parse probe failed: {stdout}");
+        let line = stdout
+            .lines()
+            .find_map(|line| line.split_once("PROBE ").map(|(_, result)| result))
+            .unwrap_or_else(|| panic!("parse probe printed no result: {stdout}"));
+        let result: Result<Vec<String>, String> =
+            serde_json::from_str(line).expect("parse probe result is JSON");
+        result
+    }
+
+    /// Does nothing in a normal test run. In the child spawned by `parse`, it
+    /// parses the arguments it was given and prints the result for the parent.
+    #[test]
+    fn insecure_registry_parse_probe() {
+        let Ok(args) = std::env::var(CHILD_ARGS) else {
+            return;
+        };
+        let args = args.split('\u{1f}').filter(|arg| !arg.is_empty());
+        let result: Result<Vec<String>, String> =
+            Cli::try_parse_from(std::iter::once("wash").chain(args))
+                .map(|cli| cli.host.insecure_registries)
+                .map_err(|err| err.to_string());
+        println!("PROBE {}", serde_json::to_string(&result).unwrap());
+    }
+
+    #[test]
+    fn insecure_registry_defaults_to_empty() {
+        assert_eq!(parse(&[], None).unwrap(), Vec::<String>::new());
+    }
+
+    #[test]
+    fn insecure_registry_flag_is_repeatable_and_comma_delimited() {
+        assert_eq!(
+            parse(
+                &[
+                    "--insecure-registry",
+                    "localhost:5000",
+                    "--insecure-registry",
+                    "di-framework-registry:5000,reg.example:8080",
+                ],
+                None,
+            )
+            .unwrap(),
+            vec![
+                "localhost:5000",
+                "di-framework-registry:5000",
+                "reg.example:8080"
+            ],
+        );
+    }
+
+    #[test]
+    fn insecure_registry_env_is_a_comma_list_and_trimmed() {
+        assert_eq!(
+            parse(&[], Some("localhost:5000, di-framework-registry:5000 ")).unwrap(),
