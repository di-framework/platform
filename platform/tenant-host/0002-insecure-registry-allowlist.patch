+    #[test]
+    fn insecure_registry_rejects_empty_entries() {
+        let err = parse(&[], Some("localhost:5000,")).unwrap_err();
+        assert!(err.contains("empty registry entry"), "{err}");
+        let err = parse(&["--insecure-registry", " "], None).unwrap_err();
+        assert!(err.contains("empty registry entry"), "{err}");
+    }
+
+    #[test]
+    fn insecure_registry_rejects_scheme_prefixed_entries() {
+        let err = parse(&["--insecure-registry", "http://localhost:5000"], None).unwrap_err();
+        assert!(err.contains("has a scheme"), "{err}");
