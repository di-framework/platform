+fn leased_result_too_large() -> Error {
+    Error::Other(
+        "postgres query result exceeds the host buffer for a leased connection".to_string(),
+    )
+}
+
+/// Read every row of a leased query, refusing a result that would sit unbounded
+/// in host memory. The caller returns the connection after this finishes.
+async fn collect_rows(
+    client: &deadpool_postgres::Client,
+    stmt: tokio_postgres::Statement,
+    params: Vec<PgValue>,
+) -> Result<Vec<Row>, Error> {
+    let param_refs = params
+        .iter()
+        .map(|p| p as &(dyn ToSql + Sync))
+        .collect::<Vec<_>>();
+    let stream = client
+        .query_raw(&stmt, param_refs)
+        .await
+        .map_err(|e| to_wit_error(&e))?;
+    let mut stream = std::pin::pin!(stream);
+    let mut rows = Vec::new();
+    let mut bytes = 0usize;
+    loop {
+        match stream.try_next().await {
+            Ok(Some(row)) => {
+                let values = conversions::row_to_values(&row)?;
+                let next = bytes.saturating_add(row_payload_bytes(&values));
+                if rows.len() >= LEASED_ROW_CAP || next > LEASED_BYTE_CAP {
+                    return Err(leased_result_too_large());
+                }
+                bytes = next;
+                rows.push(values);
+            }
+            Ok(None) => return Ok(rows),
+            Err(e) => return Err(to_wit_error(&e)),
+        }
+    }
+}
+
+/// Bytes of heap payload in a row. Scalars and unrecognized variants count as 16
+/// so the leased cap still moves when a result is wide but not textual.
+fn row_payload_bytes(row: &Row) -> usize {
+    row.iter().map(value_payload_bytes).sum()
+}
+
+fn value_payload_bytes(value: &PgValue) -> usize {
+    match value {
+        PgValue::Null => 0,
+        PgValue::Text(s)
+        | PgValue::Json(s)
+        | PgValue::Jsonb(s)
+        | PgValue::Xml(s)
+        | PgValue::Name(s)
+        | PgValue::Uuid(s)
+        | PgValue::Cidr(s)
+        | PgValue::Inet(s)
+        | PgValue::TsQuery(s)
+        | PgValue::Numeric(s)
+        | PgValue::Decimal(s)
+        | PgValue::Money(s) => s.len(),
+        PgValue::Bytea(bytes) => bytes.len(),
+        PgValue::TextArray(items)
+        | PgValue::JsonArray(items)
+        | PgValue::JsonbArray(items)
+        | PgValue::XmlArray(items)
+        | PgValue::NameArray(items)
+        | PgValue::UuidArray(items)
+        | PgValue::CidrArray(items)
+        | PgValue::InetArray(items)
+        | PgValue::NumericArray(items)
+        | PgValue::MoneyArray(items) => items.iter().map(String::len).sum(),
+        PgValue::ByteaArray(items) => items.iter().map(Vec::len).sum(),
+        PgValue::Varchar((_, bytes))
+        | PgValue::BitVarying((_, bytes))
+        | PgValue::Varbit((_, bytes)) => bytes.len(),
+        PgValue::Char((_, bytes)) | PgValue::Bit((_, bytes)) => bytes.len(),
+        PgValue::VarcharArray(items) | PgValue::VarbitArray(items) => {
+            items.iter().map(|(_, bytes)| bytes.len()).sum()
+        }
+        PgValue::CharArray(items) | PgValue::BitArray(items) => {
+            items.iter().map(|(_, bytes)| bytes.len()).sum()
+        }
+        PgValue::Hstore(pairs) => pairs
+            .iter()
+            .map(|(key, value)| key.len() + value.as_ref().map(String::len).unwrap_or(0))
+            .sum(),
+        PgValue::TsVector(lexemes) => lexemes.iter().map(|lexeme| lexeme.data.len()).sum(),
+        PgValue::Int8Array(items) => items.len() * 8,
+        PgValue::Float8Array(items) => items.len() * 8,
+        PgValue::Int4Array(items) => items.len() * 4,
+        PgValue::Float4Array(items) => items.len() * 4,
+        PgValue::Int2Array(items) | PgValue::Int2Vector(items) => items.len() * 2,
+        PgValue::Int2VectorArray(items) => items.iter().map(Vec::len).sum::<usize>() * 2,
+        PgValue::BoolArray(items) => items.len(),
+        PgValue::Path(points) | PgValue::Polygon(points) | PgValue::PointArray(points) => {
+            points.len() * 16
+        }
+        PgValue::PathArray(paths) | PgValue::PolygonArray(paths) => {
+            paths.iter().map(Vec::len).sum::<usize>() * 16
+        }
+        _ => 16,
+    }
+}
