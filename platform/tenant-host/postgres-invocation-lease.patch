+#[cfg(test)]
+mod tests {
+    use super::PgValue;
+    use super::TxBoundary;
+    use super::row_payload_bytes;
+    use super::transaction_boundary;
+
+    #[test]
+    fn transaction_boundary_matches_the_adapter_statements() {
+        assert_eq!(transaction_boundary("BEGIN"), TxBoundary::Begin);
+        assert_eq!(transaction_boundary("  commit ;"), TxBoundary::Commit);
+        assert_eq!(transaction_boundary("ROLLBACK"), TxBoundary::Rollback);
+        assert_eq!(
+            transaction_boundary("SELECT txid_current()"),
+            TxBoundary::None
+        );
+        assert_eq!(
+            transaction_boundary("BEGIN;\nINSERT INTO t VALUES (1);"),
+            TxBoundary::None
+        );
+    }
+
+    #[test]
+    fn leased_buffer_counts_text_and_bytea_payloads() {
+        let row = vec![
+            PgValue::Text("hello".into()),
+            PgValue::Bytea(vec![1, 2, 3, 4]),
+            PgValue::Null,
+        ];
+        assert_eq!(row_payload_bytes(&row), 5 + 4);
+    }
+
+    #[test]
+    fn transaction_boundary_recognizes_abort() {
+        assert_eq!(transaction_boundary("ABORT"), TxBoundary::Rollback);
+        assert_eq!(transaction_boundary("  ABORT ;"), TxBoundary::Rollback);
+    }
+
+    #[test]
+    fn transaction_boundary_recognizes_start_transaction() {
+        assert_eq!(transaction_boundary("START TRANSACTION"), TxBoundary::Begin);
+        assert_eq!(transaction_boundary("START TRANSACTION READ ONLY"), TxBoundary::Begin);
+    }
+}
