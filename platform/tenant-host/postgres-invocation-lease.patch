+#[derive(Clone, Copy, PartialEq, Eq)]
+enum TxBoundary {
+    None,
+    Begin,
+    Commit,
+    Rollback,
+}
+
+/// `BEGIN` / `COMMIT` / `ROLLBACK` as their own batch, which is how
+/// `SqlDatabase.transaction` brackets a transaction. A multi-statement script
+/// is not a boundary even if it contains those words.
+fn transaction_boundary(sql: &str) -> TxBoundary {
+    let statement = sql.trim().trim_end_matches(';').trim();
+    let upper = statement.to_ascii_uppercase();
+    if upper == "BEGIN" || upper.starts_with("BEGIN ") || upper == "START TRANSACTION" {
+        TxBoundary::Begin
+    } else if upper == "COMMIT" || upper.starts_with("COMMIT ") {
+        TxBoundary::Commit
+    } else if upper == "ROLLBACK" || upper.starts_with("ROLLBACK ") || upper == "ABORT" {
+        TxBoundary::Rollback
+    } else {
+        TxBoundary::None
+    }
+}
+
+fn store_id_of<U>(store: &Accessor<U, SharedCtx>) -> wasmtime::Result<String> {
+    // `get()` is the active component context (`HasData::Data`), which carries
+    // the store-wide id shared by every host call in this invocation.
+    store.with(|mut access| Ok(access.get().store_id.to_string()))
+}
+
+async fn current_lease(
+    plugin: &WasmcloudPostgres,
+    store_id: &str,
+) -> Option<Arc<super::InvocationLease>> {
+    plugin
+        .invocation_leases
+        .lock()
+        .await
+        .get(store_id)
+        .map(Arc::clone)
+}
+
+/// Check out one connection and keep it for this store until the transaction ends.
+async fn pin_lease(
+    plugin: &WasmcloudPostgres,
+    store_id: &str,
+    database: &str,
+) -> Result<Arc<super::InvocationLease>, Error> {
+    if let Some(existing) = current_lease(plugin, store_id).await {
+        if existing.database != database {
+            return Err(Error::Other(
+                "postgres transaction is bound to a different database".to_string(),
+            ));
+        }
+        return Ok(existing);
+    }
+    let client = client_for(plugin, database).await?;
+    let lease = Arc::new(super::InvocationLease {
+        database: database.to_string(),
+        slot: Mutex::new(Some(client)),
+        available: tokio::sync::Notify::new(),
+    });
+    let mut leases = plugin.invocation_leases.lock().await;
+    if let Some(existing) = leases.get(store_id) {
+        if existing.database != database {
+            return Err(Error::Other(
+                "postgres transaction is bound to a different database".to_string(),
+            ));
+        }
+        return Ok(Arc::clone(existing));
+    }
+    leases.insert(store_id.to_string(), Arc::clone(&lease));
+    Ok(lease)
+}
+
+async fn finish_lease(plugin: &WasmcloudPostgres, store_id: &str) {
+    plugin.invocation_leases.lock().await.remove(store_id);
+}
+
+impl WasmcloudPostgres {
+    /// Drop this store's pinned connection, rolling back a transaction the
+    /// guest left open. A finished `COMMIT` / `ROLLBACK` already removed it.
+    pub async fn release_invocation_lease(&self, store_id: &str) {
+        let removed = self.invocation_leases.lock().await.remove(store_id);
+        let Some(lease) = removed else {
+            return;
+        };
+        if let Some(client) = lease.slot.lock().await.take() {
+            let _ = client.batch_execute("ROLLBACK").await;
+        }
+    }
+}
+
+/// Take the leased connection, waiting if another host call still holds it.
+async fn borrow_client(lease: &super::InvocationLease) -> deadpool_postgres::Client {
+    loop {
+        let notified = lease.available.notified();
+        if let Some(client) = lease.slot.lock().await.take() {
+            return client;
+        }
+        notified.await;
+    }
+}
+
+async fn return_client(lease: Arc<super::InvocationLease>, client: deadpool_postgres::Client) {
+    *lease.slot.lock().await = Some(client);
+    lease.available.notify_one();
+}
+
+/// Release any connection this invocation still holds. Safe when postgres is
+/// not linked.
+pub async fn release_store_lease(accessor: &Accessor<SharedCtx>) {
+    let found = accessor.with(|mut access| {
+        let ctx = &access.get().active_ctx;
+        let store_id = ctx.store_id.to_string();
+        let plugin = ctx
+            .try_get_plugin::<WasmcloudPostgres>(PLUGIN_POSTGRES_ID)
+            .ok();
+        (store_id, plugin)
+    });
+    if let Some(plugin) = found.1 {
+        plugin.release_invocation_lease(&found.0).await;
+    }
+}
