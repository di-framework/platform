+    };
+    tokio::time::sleep(Duration::from_millis(2)).await;
+    let behind: Vec<_> = (0..6)
+        .map(|_| {
+            let rig = Arc::clone(&rig);
+            tokio::spawn(async move { rig.call("slow", PATIENT).await })
+        })
+        .collect();
+
+    assert!(trapper.await.unwrap().is_err(), "the trapping call fails");
+    for call in behind {
+        assert_eq!(call.await.unwrap().expect("served after the trap"), 7);
+    }
+
+    assert_eq!(
+        rig.peak(),
+        1,
+        "the replacement waited for the faulted store"
+    );
+    assert_eq!(rig.created(), 2, "one instance before the trap, one after");
+}
+
+/// A caller that gives up on a slow call does not free the instance: the
+/// guest is still running on it, so the next caller waits for the work to end
+/// and for the store to be dropped. The instance is retired (as a timed-out
+/// call retires it), so its replacement is built afterwards, and only once the
+/// old store's teardown, held open here, has finished.
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn a_timed_out_call_still_holds_the_line_until_its_store_is_gone() {
+    let rig = Rig::exclusive(None);
+    rig.hold_teardown();
+    let _release = ReleaseOnDrop(Arc::clone(&rig));
+
+    let started = Instant::now();
+    let abandoned = {
+        let rig = Arc::clone(&rig);
+        tokio::spawn(async move { rig.call("slow", Duration::from_millis(1)).await })
+    };
+    assert!(
+        abandoned.await.unwrap().is_err(),
+        "the caller gave up before the reply"
+    );
+    // What the instance does on a call that timed out: stop admitting, drain,
+    // drop the store.
+    for driver in rig.pool.lock_drivers().iter() {
+        driver.retire();
+    }
+
+    let behind = {
+        let rig = Arc::clone(&rig);
+        tokio::spawn(async move { rig.call("ok", PATIENT).await })
+    };
+    rig.assert_replacement_waits(&behind).await;
+    // The line also waited for the slow guest work to end first.
+    assert!(
+        started.elapsed() >= Duration::from_millis(30),
+        "the line waited for the abandoned work"
+    );
+
+    rig.release_teardown();
+    assert_eq!(behind.await.unwrap().expect("served after the timeout"), 7);
+    assert_eq!(rig.peak(), 1, "no second store beside the abandoned one");
+    assert_eq!(rig.created(), 2);
+}
+
+/// Retiring an instance with a call in flight (`max_invocations` spent, or a
+/// timeout) drains it. The replacement is built under the next caller's
+/// permit, and its store lease only comes once the retired store is dropped:
+/// the old store's teardown is held open here, and the replacement must not
+/// be built until it is released.
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn drain_with_a_call_in_flight_releases_before_the_replacement() {
+    let rig = Rig::exclusive(None);
+    rig.hold_teardown();
+    let _release = ReleaseOnDrop(Arc::clone(&rig));
+
+    let in_flight = {
+        let rig = Arc::clone(&rig);
+        tokio::spawn(async move { rig.call("slow", PATIENT).await })
+    };
+    // The call is on the instance; retire it mid-call.
+    loop {
+        let retired = {
+            let drivers = rig.pool.lock_drivers();
+            drivers.first().is_some_and(|driver| {
+                let busy = driver.in_flight() == 1;
+                if busy {
+                    driver.retire();
+                }
+                busy
+            })
+        };
+        if retired {
+            break;
+        }
+        tokio::time::sleep(Duration::from_millis(1)).await;
+    }
+
+    let behind = {
+        let rig = Arc::clone(&rig);
+        tokio::spawn(async move { rig.call("ok", PATIENT).await })
+    };
+
+    assert_eq!(in_flight.await.unwrap().expect("drains to completion"), 7);
+    rig.assert_replacement_waits(&behind).await;
+
+    rig.release_teardown();
+    assert_eq!(behind.await.unwrap().expect("replacement serves"), 7);
+    assert_eq!(rig.peak(), 1, "the replacement waited for the drain");
+    assert_eq!(rig.created(), 2);
+}
+
+/// `max_invocations` retires and replaces the instance without ever
+/// overlapping two stores: when the budget is spent the next caller's
+/// replacement waits for the spent store's teardown, held open here.
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn rotation_by_invocation_budget_never_overlaps() {
+    let rig = Rig::exclusive(Some(2));
+    rig.hold_teardown();
+    let _release = ReleaseOnDrop(Arc::clone(&rig));
+
+    let mut calls = Vec::new();
+    for _ in 0..3 {
+        let rig = Arc::clone(&rig);
+        calls.push(tokio::spawn(async move { rig.call("ok", PATIENT).await }));
+        tokio::time::sleep(Duration::from_millis(10)).await;
+    }
+    let third = calls.pop().unwrap();
+    for call in calls {
+        assert_eq!(call.await.unwrap().expect("within the budget"), 7);
+    }
+    rig.assert_replacement_waits(&third).await;
+
+    rig.release_teardown();
+    assert_eq!(third.await.unwrap().expect("served by the replacement"), 7);
+    assert_eq!(rig.peak(), 1);
+    assert_eq!(rig.created(), 2);
+
+    // And many rotations in a row stay at one live store.
+    let more: Vec<_> = (0..9)
+        .map(|_| {
+            let rig = Arc::clone(&rig);
+            tokio::spawn(async move { rig.call("slow", PATIENT).await })
+        })
+        .collect();
+    for call in more {
+        call.await.unwrap().expect("served");
+    }
+    assert_eq!(rig.peak(), 1);
+}
