+// --- Across workloads (#152) ------------------------------------------------
+//
+// A Recreate rollout starts the next revision of a workload before the old one
+// has stopped, and each revision is a workload of its own with pools of its
+// own. The gate therefore comes from the host's registry, keyed by what the
+// component would open twice: its volume mounts' canonical host paths, or with
+// none its namespace and name. These build the workloads the way the host does
+// (`Engine::initialize_workload` then `resolve`), stop them the way it does
+// (`unbind_all_plugins`, which `workload_stop` runs) and drive calls through
+// their real pools.
+
+/// An exclusive component running the test guest, mounting `host_path` if
+/// given, in a workload of its own on `engine`, initialized and resolved the
+/// way the host does it.
+async fn exclusive_workload(
+    engine: &crate::engine::Engine,
+    namespace: &str,
+    workload_name: &str,
+    host_path: Option<&std::path::Path>,
+) -> crate::engine::workload::ResolvedWorkload {
+    let mut local_resources = crate::types::LocalResources::default();
+    local_resources
+        .config
+        .insert(EXCLUSIVE_INSTANCE_KEY.to_string(), "true".to_string());
+    let mut volumes = Vec::new();
+    if let Some(host_path) = host_path {
+        volumes.push(crate::types::Volume {
+            name: "data".to_string(),
+            volume_type: crate::types::VolumeType::HostPath(crate::types::HostPathVolume {
+                local_path: host_path.to_string_lossy().into_owned(),
+            }),
+        });
+        local_resources
+            .volume_mounts
+            .push(crate::types::VolumeMount {
+                name: "data".to_string(),
+                mount_path: "/data".to_string(),
+                read_only: false,
+            });
+    }
+    let workload = crate::types::Workload {
+        namespace: namespace.to_string(),
+        name: workload_name.to_string(),
+        annotations: Default::default(),
+        service: None,
+        components: vec![crate::types::Component {
+            name: "pglite".to_string(),
+            bytes: wat::parse_str(GUEST).expect("guest is valid").into(),
+            local_resources,
+            ..Default::default()
+        }],
+        host_interfaces: vec![],
+        volumes,
+    };
+    engine
+        .initialize_workload(uuid::Uuid::new_v4().to_string(), workload)
+        .expect("workload initializes")
+        .resolve(None, Arc::new(crate::host::http::NullServer::default()))
+        .await
+        .expect("workload resolves")
+}
+
+fn one_engine() -> crate::engine::Engine {
+    crate::engine::Engine::builder()
+        .build()
+        .expect("engine builds")
+}
+
+fn same_gate(a: &Rig, b: &Rig) -> bool {
+    Arc::ptr_eq(
+        a.pool.gate().expect("exclusive"),
+        b.pool.gate().expect("exclusive"),
+    )
+}
+
+/// Assert `call` is still waiting after a while, and that only one store has
+/// been built between the rigs counting into `live`.
+async fn assert_still_waiting<T>(call: &tokio::task::JoinHandle<T>, live: &Live) {
+    tokio::time::sleep(Duration::from_millis(300)).await;
+    assert!(
+        !call.is_finished(),
+        "the next revision ran while the old one held the component"
+    );
+    assert_eq!(live.created.load(Ordering::SeqCst), 1);
+    assert_eq!(live.now.load(Ordering::SeqCst), 1);
+}
+
+/// Wait until the registry's entry for `key` can no longer be upgraded.
+async fn gate_released(engine: &crate::engine::Engine, key: &GateKey) {
+    let deadline = Instant::now() + Duration::from_secs(20);
+    loop {
+        let entry = engine
+            .exclusive_gates
+            .entry(key)
+            .expect("the key was registered");
+        if entry.upgrade().is_none() {
+            return;
+        }
+        assert!(Instant::now() < deadline, "the gate was never released");
+        tokio::time::sleep(Duration::from_millis(5)).await;
+    }
+}
+
+/// Two revisions mounting the same host path share one gate: the new
+/// revision's first call waits while the old revision's warm instance holds the
+/// component, and proceeds once the old workload is stopped. Once both are
+/// stopped, nothing holds the gate and its registry entry is dead.
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn revisions_mounting_one_host_path_share_one_gate() {
+    let dir = tempfile::tempdir().expect("temp dir");
+    let engine = one_engine();
+    let live = Arc::<Live>::default();
+
+    let old = exclusive_workload(&engine, "tenant", "pglite-rev1", Some(dir.path())).await;
+    let new = exclusive_workload(&engine, "tenant", "pglite-rev2", Some(dir.path())).await;
+    let old_rig = Rig::on_workload(&engine, &old, &live).await;
+    let new_rig = Rig::on_workload(&engine, &new, &live).await;
+    assert!(same_gate(&old_rig, &new_rig), "one gate per host path");
+
+    // The old revision is serving: its warm instance holds the store lease.
+    assert_eq!(old_rig.call("ok", PATIENT).await.expect("old serves"), 7);
+
+    let first_call = {
+        let new_rig = Arc::clone(&new_rig);
+        tokio::spawn(async move { new_rig.call("ok", PATIENT).await })
+    };
+    assert_still_waiting(&first_call, &live).await;
+
+    // Stop the old revision the way `workload_stop` does.
+    old.unbind_all_plugins().await.expect("old stops");
+    assert_eq!(
+        first_call
+            .await
+            .unwrap()
+            .expect("served once the old revision is gone"),
+        7
+    );
+    assert_eq!(old_rig.peak(), 1, "never two stores of the component");
+    assert_eq!(old_rig.created(), 2);
+
+    // A late call to the stopped revision is refused rather than built.
+    let err = old_rig
+        .call("ok", PATIENT)
+        .await
+        .expect_err("a stopped revision serves nothing");
+    assert!(err.to_string().contains("stopping"), "{err}");
+    assert_eq!(old_rig.created(), 2);
+
+    // Stop the new revision too, and let everything go.
+    new.unbind_all_plugins().await.expect("new stops");
+    let key = GateKey::Volumes(vec![
+        std::fs::canonicalize(dir.path()).expect("canonical path"),
+    ]);
+    drop((old_rig, new_rig, old, new));
+    gate_released(&engine, &key).await;
+    assert_eq!(live.now.load(Ordering::SeqCst), 0);
+}
