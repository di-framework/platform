+/// A caller that goes away while queued leaves the line and holds nobody up.
+#[tokio::test]
+async fn a_cancelled_waiter_leaves_the_line() {
+    let rig = Rig::exclusive(None);
+    let held = rig.pool.admit_call().await.unwrap();
+
