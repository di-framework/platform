+/// Both gates share one budget: time spent in line for the call permit is
+/// not given again to the store lease.
+#[tokio::test]
+async fn the_call_permit_and_the_store_lease_share_one_deadline() {
+    let rig = Rig::exclusive(None);
+    let gate = rig.pool.store_gate().expect("exclusive");
+    let held = rig.pool.admit_call().await.unwrap();
+
