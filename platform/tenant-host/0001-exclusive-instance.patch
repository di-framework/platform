+
+/// The registry hands out one live gate per key and a fresh one once the old
+/// gate is gone, pruning dead entries as it goes.
+#[test]
+fn the_registry_shares_live_gates_and_forgets_dead_ones() {
+    let gates = ExclusiveGates::default();
+    let key = |p: &str| {
+        GateKey::for_component(
+            [std::path::PathBuf::from(p)],
+            &Arc::from("ns"),
+            &Arc::from("c"),
+        )
+    };
+
+    let first = gates.gate_for(key("/data"));
+    assert!(Arc::ptr_eq(&first, &gates.gate_for(key("/data"))));
+    assert!(!Arc::ptr_eq(&first, &gates.gate_for(key("/other"))));
+    // Order and duplicates of the mounts do not matter.
+    assert_eq!(
+        GateKey::for_component(
+            ["/b", "/a", "/b"].map(std::path::PathBuf::from),
+            &Arc::from("ns"),
+            &Arc::from("c")
+        ),
+        GateKey::Volumes(vec!["/a".into(), "/b".into()])
+    );
+
+    let weak = Arc::downgrade(&first);
+    drop(first);
+    assert!(weak.upgrade().is_none());
+    assert!(
+        gates
+            .entry(&key("/data"))
+            .is_some_and(|w| w.upgrade().is_none())
+    );
+    let _again = gates.gate_for(key("/again"));
+    assert!(
+        gates.entry(&key("/data")).is_none(),
+        "dead entries are pruned"
+    );
+}
