+/// The store lease, on its own, is what bounds live stores: a store built on a
+/// path that skips the call permit entirely (a cold store, a service, a
+/// messaging delivery) still waits for the live one to be dropped.
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn a_store_built_around_the_call_permit_still_waits_for_the_live_one() {
+    let rig = Rig::exclusive(None);
+
+    let first = rig.build(None).await.expect("first store");
+    let second = {
+        let rig = Arc::clone(&rig);
+        tokio::spawn(async move { rig.build(None).await })
+    };
+    tokio::time::sleep(Duration::from_millis(100)).await;
+    assert!(!second.is_finished(), "must wait while the first is alive");
+    assert_eq!(rig.live.now.load(Ordering::SeqCst), 1);
+
+    drop(first);
+    let second = second.await.unwrap().expect("built once the first is gone");
+    assert_eq!(rig.peak(), 1);
+    drop(second);
+    rig.settled().await;
+}
