+/// A store with a lease releases it when it is dropped, trap or no trap: the
+/// lease lives in the store's own context.
+#[tokio::test]
+async fn dropping_a_store_releases_its_lease() {
+    let rig = Rig::exclusive(None);
+    let gate = rig.pool.store_gate().expect("exclusive");
+    assert_eq!(gate.available_permits(), 1);
+
+    let built = rig.build(None).await.expect("store");
+    assert_eq!(
