+//! Exclusive components never have two stores alive at once.
+//!
+//! These drive real concurrency through the production dispatch path
+//! ([`InstancePool::admit_call`] then [`InstancePool::dispatch`], which builds
+//! and installs real [`wasmtime::Store`]s holding real component instances and
+//! hands real jobs to real [`InstanceDriver`]s) and count live stores. The
+//! counter is a value the test pushes into each store's resource table, which
+//! the store drops before its leases (see `SharedCtx`), so it falls before the
+//! next store can be admitted: a store built without waiting for the previous
+//! one to be dropped would show up as a peak of two.
+//!
+//! The guest is a small component with three exports: `ok` returns at once,
+//! `slow` computes for a while without yielding, and `trap` traps.
+
+use std::sync::Arc;
+use std::sync::atomic::{AtomicUsize, Ordering};
+use std::time::{Duration, Instant};
+
+use wasmtime::component::{Component, Linker};
+
+use super::*;
+use crate::engine::abandon::{AbandonedCallPolicy, DispatchedCall, arm_epoch_deadline};
+use crate::engine::ctx::Ctx;
+use crate::engine::instance_driver::LinkedJob;
+
+const GUEST: &str = r#"
+(component
+  (core module $m
+    (func (export "ok") (result i32) i32.const 7)
+    (func (export "slow") (result i32)
+      (local $i i32)
+      (local.set $i (i32.const 150000000))
+      (loop $spin
+        (local.set $i (i32.sub (local.get $i) (i32.const 1)))
+        (br_if $spin (local.get $i)))
+      i32.const 7)
+    (func (export "trap") (result i32) unreachable))
+  (core instance $i (instantiate $m))
+  (func (export "ok") (result u32) (canon lift (core func $i "ok")))
+  (func (export "slow") (result u32) (canon lift (core func $i "slow")))
+  (func (export "trap") (result u32) (canon lift (core func $i "trap"))))
+"#;
+
+/// Live-store accounting shared by every store a rig builds.
+#[derive(Default)]
+struct Live {
+    now: AtomicUsize,
+    peak: AtomicUsize,
+    created: AtomicUsize,
+    /// Stores whose teardown has begun.
+    tearing_down: AtomicUsize,
+    /// While set, a store's teardown blocks, as a store flushing a database
+    /// would, and the store still counts as live.
+    hold_teardown: std::sync::Mutex<bool>,
+    teardown_released: std::sync::Condvar,
+}
+
+/// Lives in a store's resource table: counts the store while it exists.
+struct LiveStore(Arc<Live>);
+
+impl LiveStore {
+    fn enter(live: &Arc<Live>) -> Self {
+        let now = live.now.fetch_add(1, Ordering::SeqCst) + 1;
+        live.peak.fetch_max(now, Ordering::SeqCst);
+        live.created.fetch_add(1, Ordering::SeqCst);
+        Self(Arc::clone(live))
+    }
+}
+
+impl Drop for LiveStore {
+    fn drop(&mut self) {
+        // Tearing a store down takes a while (closing files, flushing a
+        // database), and the store still counts as live throughout. A
+        // replacement that did not wait for it would be built in this window.
+        self.0.tearing_down.fetch_add(1, Ordering::SeqCst);
+        if *self.0.hold_teardown.lock().unwrap() {
+            // Blocking a runtime worker would strand the tasks queued on it,
+            // so hand its queue to another thread while this one waits.
+            tokio::task::block_in_place(|| {
+                let mut held = self.0.hold_teardown.lock().unwrap();
+                while *held {
+                    held = self.0.teardown_released.wait(held).unwrap();
+                }
+            });
+        }
+        std::thread::sleep(Duration::from_millis(20));
+        self.0.now.fetch_sub(1, Ordering::SeqCst);
+    }
+}
+
+/// Releases held teardowns when a test ends, however it ends, so a failed
+/// assertion does not leave a blocked thread behind.
+struct ReleaseOnDrop(Arc<Rig>);
+
+impl Drop for ReleaseOnDrop {
+    fn drop(&mut self) {
+        self.0.release_teardown();
+    }
+}
+
+struct Rig {
+    pool: Arc<InstancePool>,
+    live: Arc<Live>,
+    engine: crate::engine::Engine,
+    component: Component,
+    linker: Linker<SharedCtx>,
+}
+
+impl Rig {
+    fn exclusive(max_invocations: Option<usize>) -> Arc<Self> {
+        let policy = InstancePolicy::Exclusive {
+            max_invocations: max_invocations.and_then(NonZeroUsize::new),
+        };
+        Self::with_policy(policy)
+    }
+
+    fn with_policy(policy: InstancePolicy) -> Arc<Self> {
+        let engine = crate::engine::Engine::builder()
+            .build()
+            .expect("engine builds");
+        Self::on_pool(engine, Arc::new(InstancePool::new(policy)), Arc::default())
+    }
+
+    /// A rig driving `pool`, counting its stores in `live`.
+    fn on_pool(
+        engine: crate::engine::Engine,
+        pool: Arc<InstancePool>,
+        live: Arc<Live>,
+    ) -> Arc<Self> {
+        let bytes = wat::parse_str(GUEST).expect("guest is valid");
+        let component = Component::new(engine.inner(), bytes).expect("guest compiles");
+        let linker = Linker::new(engine.inner());
+        Arc::new(Self {
+            pool,
+            live,
+            engine,
+            component,
+            linker,
+        })
+    }
+
+    /// A rig driving the pool of the one component of `workload`, as the host
+    /// resolved it.
+    async fn on_workload(
+        engine: &crate::engine::Engine,
+        workload: &crate::engine::workload::ResolvedWorkload,
+        live: &Arc<Live>,
+    ) -> Arc<Self> {
+        let pool = {
+            let components = workload.components();
+            let components = components.read().await;
+            let component = components.values().next().expect("one component");
+            Arc::clone(&component.instances)
+        };
+        Self::on_pool(engine.clone(), pool, Arc::clone(live))
+    }
+
+    /// What the call sites' `build` closures do: take the store lease the way
+    /// `new_store` does, build a real store that carries it, instantiate the
+    /// guest into it.
+    async fn build(&self, deadline: Option<Deadline>) -> anyhow::Result<ComponentInstance> {
+        let gates: Vec<_> = self.pool.store_gate().into_iter().collect();
+        let leases = lease_stores(gates, deadline).await?;
+        let mut ctx = SharedCtx::new(Ctx::builder("wk", "guest").build());
+        ctx.leases = leases;
+        ctx.table.push(LiveStore::enter(&self.live))?;
+        let mut store = wasmtime::Store::new(self.engine.inner(), ctx);
+        arm_epoch_deadline(&mut store, AbandonedCallPolicy::Trap);
+        let instance = self
+            .linker
+            .instantiate_async(&mut store, &self.component)
+            .await?;
+        Ok(ComponentInstance { store, instance })
+    }
+
+    /// One call as a call site makes it: wait in line, offer it to the pool
+    /// (building an instance if told to), then wait for the reply for at most
+    /// `give_up_after`. Returns the guest's answer.
+    async fn call(
+        self: &Arc<Self>,
+        export: &'static str,
+        give_up_after: Duration,
+    ) -> anyhow::Result<u32> {
+        let mut permit = self.pool.admit_call().await?;
+        let (reply, reply_rx) = tokio::sync::oneshot::channel();
+        let flag = DispatchedCall::new("test", Duration::from_secs(60)).flag();
+        let func_idx = self
+            .component
+            .get_export_index(None, export)
+            .expect("guest exports it");
+        let job = InstanceJob::Linked(Box::new(LinkedJob {
+            func_idx,
+            params: vec![],
+            results_len: 1,
+            import_name: Arc::from("test"),
+            export_name: Arc::from(export),
+            reply,
+            abandoned: flag,
+        }));
+        let rig = Arc::clone(self);
+        let outcome = self
+            .pool
+            .dispatch(job, &mut permit, |deadline| async move {
+                rig.build(deadline).await
+            })
+            .await?;
+        anyhow::ensure!(
+            outcome.is_ok(),
+            "an exclusive pool must not decline a call to a store of its own"
+        );
+        let vals = tokio::time::timeout(give_up_after, reply_rx)
+            .await
+            .map_err(|_| anyhow::anyhow!("gave up waiting for the reply"))?
+            .map_err(|_| anyhow::anyhow!("the instance dropped the call"))?
+            .map_err(|e| anyhow::anyhow!("{e:#}"))?;
+        match vals.as_slice() {
+            [wasmtime::component::Val::U32(v)] => Ok(*v),
+            other => anyhow::bail!("unexpected results {other:?}"),
+        }
+    }
+
+    fn peak(&self) -> usize {
+        self.live.peak.load(Ordering::SeqCst)
+    }
+
+    fn created(&self) -> usize {
+        self.live.created.load(Ordering::SeqCst)
+    }
+
+    /// Make every store's teardown block until [`Self::release_teardown`].
+    fn hold_teardown(&self) {
+        *self.live.hold_teardown.lock().unwrap() = true;
+    }
+
+    fn release_teardown(&self) {
+        *self.live.hold_teardown.lock().unwrap() = false;
+        self.live.teardown_released.notify_all();
+    }
+
+    /// With the old store's teardown held open and a caller waiting behind it,
+    /// check the replacement has not been built. Only the store lease can
+    /// hold it back here: the call permit is long free.
+    async fn assert_replacement_waits<T>(&self, behind: &tokio::task::JoinHandle<T>) {
+        let deadline = Instant::now() + Duration::from_secs(20);
+        while self.live.tearing_down.load(Ordering::SeqCst) < 1 {
+            assert!(
+                Instant::now() < deadline,
+                "the old store was never torn down"
+            );
+            tokio::time::sleep(Duration::from_millis(5)).await;
+        }
+        tokio::time::sleep(Duration::from_millis(200)).await;
+        assert_eq!(
+            self.created(),
+            1,
+            "a replacement was built while the old store was still being torn down"
+        );
+        assert!(!behind.is_finished(), "the waiting call ran too early");
+    }
+
+    /// Wait until every store has been dropped.
+    async fn settled(&self) {
+        let deadline = Instant::now() + Duration::from_secs(20);
+        while self.live.now.load(Ordering::SeqCst) != 0 {
+            assert!(Instant::now() < deadline, "a store was never dropped");
+            tokio::time::sleep(Duration::from_millis(5)).await;
+        }
+    }
+}
+
+const PATIENT: Duration = Duration::from_secs(30);
+
+/// N callers at once, each holding the instance for a while. They queue for the
+/// one warm instance: none is served from a store of its own, only one store is
+/// ever built, and at most one is ever alive.
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn saturation_queues_on_the_one_instance() {
+    let rig = Rig::exclusive(None);
+
+    let calls: Vec<_> = (0..12)
+        .map(|_| {
+            let rig = Arc::clone(&rig);
+            tokio::spawn(async move { rig.call("slow", PATIENT).await })
+        })
+        .collect();
+    for call in calls {
+        assert_eq!(call.await.unwrap().expect("every queued call is served"), 7);
+    }
+
+    assert_eq!(rig.peak(), 1, "at most one store may be alive");
+    assert_eq!(rig.created(), 1, "the queue is served by one warm instance");
+}
+
+/// The line is first come, first served.
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn callers_are_served_in_arrival_order() {
+    let rig = Rig::exclusive(None);
+    let order = Arc::new(std::sync::Mutex::new(Vec::new()));
+
+    let mut calls = Vec::new();
+    for n in 0..6 {
+        let (rig, order) = (Arc::clone(&rig), Arc::clone(&order));
+        calls.push(tokio::spawn(async move {
+            let answer = rig.call("slow", PATIENT).await;
+            order.lock().unwrap().push(n);
+            answer
+        }));
+        // Arrive one after another, well within the first call's duration.
+        tokio::time::sleep(Duration::from_millis(5)).await;
+    }
+    for call in calls {
+        call.await.unwrap().expect("served");
+    }
+
+    assert_eq!(*order.lock().unwrap(), vec![0, 1, 2, 3, 4, 5]);
+    assert_eq!(rig.peak(), 1);
+}
+
+/// Two first calls racing on an empty pool build one instance between them: the
+/// second waits for the first rather than building a store it would then throw
+/// away.
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn racing_first_calls_build_one_instance() {
+    let rig = Rig::exclusive(None);
+
+    let calls: Vec<_> = (0..8)
+        .map(|_| {
+            let rig = Arc::clone(&rig);
+            tokio::spawn(async move { rig.call("ok", PATIENT).await })
+        })
+        .collect();
+    for call in calls {
+        call.await.unwrap().expect("served");
+    }
+
+    assert_eq!(rig.created(), 1, "exactly one instantiation");
+    assert_eq!(rig.peak(), 1);
+}
