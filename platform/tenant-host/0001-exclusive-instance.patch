+/// The opt-in is read from the component's config, and only an explicit
+/// `false` opts out of an entry that is present.
+#[test]
+fn the_config_entry_selects_the_exclusive_policy() {
+    let with = |value: Option<&str>, max_invocations: i32| {
+        let mut component = crate::types::Component {
+            max_invocations,
+            pool_size: 4,
+            max_concurrency: 8,
+            ..Default::default()
+        };
+        if let Some(value) = value {
+            component
+                .local_resources
+                .config
+                .insert(EXCLUSIVE_INSTANCE_KEY.to_string(), value.to_string());
+        }
+        InstancePolicy::from_component(&component)
+    };
+
+    let exclusive = |max_invocations| InstancePolicy::Exclusive {
+        max_invocations: NonZeroUsize::new(max_invocations),
+    };
+    assert_eq!(
+        with(Some("true"), 0),
+        InstancePolicy::Exclusive {
+            max_invocations: None
+        }
+    );
+    assert_eq!(with(Some(" TRUE "), 50), exclusive(50));
+    // Pool size and concurrency do not widen an exclusive component.
+    assert_eq!(
+        with(Some("true"), -1),
+        InstancePolicy::Exclusive {
+            max_invocations: None
+        }
+    );
+    // Fails closed on a value it does not understand.
+    assert_eq!(
+        with(Some("yes"), 0),
+        InstancePolicy::Exclusive {
+            max_invocations: None
+        }
+    );
+    // Opting out, or never opting in, leaves the pooled policy as it was.
+    for policy in [with(Some("false"), 0), with(None, 0)] {
+        assert!(matches!(policy, InstancePolicy::Warm { .. }), "{policy:?}");
+        assert!(!InstancePool::new(policy).is_exclusive());
+    }
+
+    let pool = InstancePool::new(exclusive(3));
+    assert!(pool.is_exclusive());
+    assert_eq!(pool.call_concurrency(), 1);
+    assert_eq!(pool.limits(), Some((1, Some(3), 1)));
+}
