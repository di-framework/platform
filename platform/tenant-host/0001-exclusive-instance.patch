+/// A store that outlives its workload's pool (a call still running when the
+/// workload is dropped) keeps the gate alive through its lease, so the next
+/// revision gets the same gate and waits for that store.
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn a_store_outliving_its_workload_keeps_the_gate() {
+    let dir = tempfile::tempdir().expect("temp dir");
+    let engine = one_engine();
+    let live = Arc::<Live>::default();
+
+    let old = exclusive_workload(&engine, "tenant", "pglite-rev1", Some(dir.path())).await;
+    let old_rig = Rig::on_workload(&engine, &old, &live).await;
+    let orphan = old_rig.build(None).await.expect("old store");
+    old.unbind_all_plugins().await.unwrap();
+    drop((old_rig, old));
+
+    let new = exclusive_workload(&engine, "tenant", "pglite-rev2", Some(dir.path())).await;
+    let new_rig = Rig::on_workload(&engine, &new, &live).await;
+    let first_call = {
+        let new_rig = Arc::clone(&new_rig);
+        tokio::spawn(async move { new_rig.call("ok", PATIENT).await })
+    };
+    assert_still_waiting(&first_call, &live).await;
+
+    drop(orphan);
+    assert_eq!(first_call.await.unwrap().expect("served"), 7);
+    assert_eq!(new_rig.peak(), 1);
+    new.unbind_all_plugins().await.unwrap();
