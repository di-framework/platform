diff --git a/crates/wash-runtime/tests/integration_exclusive_topology.rs b/crates/wash-runtime/tests/integration_exclusive_topology.rs
new file mode 100644
index 0000000..8e24270
--- /dev/null
+++ b/crates/wash-runtime/tests/integration_exclusive_topology.rs
@@ -0,0 +1,277 @@
+//! Which workloads may contain an exclusive component.
+//!
+//! An exclusive component (`di-framework.dev/exclusive-instance: "true"` in its
+//! `localResources.config`) is only supported as a component that no other
+//! component of the workload links. Every store of an importer instantiates
+//! its exporters, so an importer would hold the exclusive component's store
+//! lease for as long as it lives and the layout could not queue. The workload
+//! is refused at load time instead; the supported shape is to compose the
+//! pieces with `wac plug` and mark the composed component exclusive.
+
+use std::collections::HashMap;
+use std::time::Duration;
+
+use anyhow::{Context, Result};
+use tokio::time::timeout;
+
+use wash_runtime::engine::EXCLUSIVE_INSTANCE_KEY;
+use wash_runtime::host::HostApi;
+use wash_runtime::types::{Component, LocalResources};
+
+mod common;
+use common::{
+    component_workload_request, http_counter_host_interfaces, http_only_host_interfaces,
+    json_u64_field, start_host_with_dev_router, start_host_with_dynamic_router,
+};
+
+const HTTP_COUNTER_WASM: &[u8] = include_bytes!("wasm/http_counter.wasm");
+const HTTP_SLEEPER_WASM: &[u8] = include_bytes!("wasm/http_sleeper.wasm");
+const CALLER_WASM: &[u8] = include_bytes!("wasm/inter_component_call_caller.wasm");
+const MIDDLEWARE_WASM: &[u8] = include_bytes!("wasm/inter_component_call_middleware.wasm");
+const CALLEE_WASM: &[u8] = include_bytes!("wasm/inter_component_call_callee.wasm");
+
+fn resources(exclusive: bool) -> LocalResources {
+    LocalResources {
+        memory_limit_mb: 256,
+        cpu_limit: 1,
+        config: if exclusive {
+            HashMap::from([(EXCLUSIVE_INSTANCE_KEY.to_string(), "true".to_string())])
+        } else {
+            HashMap::new()
+        },
+        environment: HashMap::new(),
+        volume_mounts: vec![],
+        allowed_hosts: vec!["example.com".parse().unwrap()].into(),
+        allowed_ip_name_lookups: Default::default(),
+        allowed_host_loopback_ports: Default::default(),
+    }
+}
+
+fn component(name: &str, wasm: &'static [u8], exclusive: bool) -> Component {
+    Component {
+        name: name.to_string(),
+        digest: None,
+        bytes: bytes::Bytes::from_static(wasm),
+        local_resources: resources(exclusive),
+        pool_size: 1,
+        max_invocations: 100,
+        max_concurrency: 1,
+    }
+}
+
+/// caller -> middleware -> callee, with `exclusive_name` marked exclusive.
+fn linked_chain(exclusive_name: &str) -> wash_runtime::types::WorkloadStartRequest {
+    let mut request = component_workload_request(
+        "caller",
+        "linked-chain",
+        CALLER_WASM,
+        resources(exclusive_name == "caller"),
+        http_counter_host_interfaces("test"),
+    );
+    request.workload.components.push(component(
+        "middleware",
+        MIDDLEWARE_WASM,
+        exclusive_name == "middleware",
+    ));
+    request
+        .workload
+        .components
+        .push(component("callee", CALLEE_WASM, exclusive_name == "callee"));
+    request
+}
+
+/// An exclusive component that another component imports is refused, naming
+/// both and saying what to do instead. Nothing starts and nothing waits.
+#[tokio::test]
+async fn an_exclusive_component_that_is_linked_into_another_is_refused() -> Result<()> {
+    let (_addr, host) = start_host_with_dev_router("127.0.0.1:0").await?;
+
+    for exclusive in ["middleware", "callee"] {
+        let started = std::time::Instant::now();
+        let response = host
+            .workload_start(linked_chain(exclusive))
+            .await
+            .context("the host answers a refused workload with an error status")?;
+        let status = response.workload_status;
+        assert_eq!(
+            status.workload_state,
+            wash_runtime::types::WorkloadState::Error,
+            "{status:?}"
+        );
+        let message = status.message;
+        assert!(
+            message.contains(&format!("imports '{exclusive}', which is marked exclusive")),
+            "{message}"
+        );
+        assert!(message.contains("wac plug"), "{message}");
+        assert!(
+            started.elapsed() < Duration::from_secs(30),
+            "refusal must be immediate, not a lease timeout"
+        );
+    }
+    Ok(())
+}
+
+/// The importer of the chain itself may be exclusive: it is not linked by
+/// anyone. (The chain's host interfaces are the http-only subset it needs.)
+#[tokio::test]
+async fn an_exclusive_component_nobody_links_is_not_refused_for_its_links() -> Result<()> {
+    let (_addr, host) = start_host_with_dev_router("127.0.0.1:0").await?;
+
+    // A refused workload comes back as `Ok` with an error state, so the status
+    // is what has to be checked.
+    let status = host
+        .workload_start(linked_chain("caller"))
+        .await?
+        .workload_status;
+    assert!(
+        !status.message.contains("marked exclusive"),
+        "the caller is linked by nobody: {status:?}"
+    );
+    assert_eq!(
+        status.workload_state,
+        wash_runtime::types::WorkloadState::Running,
+        "{status:?}"
+    );
+    Ok(())
+}
+
+/// A single exclusive component that imports only host interfaces still
+/// loads, and concurrent requests to it queue instead of failing. (This does
+/// not measure serialization: the counter increments atomically, so 1..=6 is
+/// the answer whether or not requests overlap. That is covered by the
+/// live-store tests in `instance_pool::exclusive_tests`.)
+#[tokio::test]
+async fn a_single_exclusive_component_loads_and_queues() -> Result<()> {
+    let (addr, host) = start_host_with_dev_router("127.0.0.1:0").await?;
+
+    let request = component_workload_request(
+        "http-counter.wasm",
+        "exclusive-counter",
+        HTTP_COUNTER_WASM,
+        resources(true),
+        http_counter_host_interfaces("excl"),
+    );
+    host.workload_start(request)
+        .await
+        .context("a lone exclusive component must load")?;
+
+    let client = reqwest::Client::new();
+    let mut requests = Vec::new();
+    for _ in 0..6 {
+        let client = client.clone();
+        requests.push(tokio::spawn(async move {
+            let response = timeout(
+                Duration::from_secs(60),
+                client
+                    .get(format!("http://{addr}/"))
+                    .header("HOST", "excl")
+                    .send(),
+            )
+            .await??;
+            anyhow::ensure!(response.status().is_success(), "{}", response.status());
+            Ok::<u64, anyhow::Error>(response.text().await?.trim().parse()?)
+        }));
+    }
+    let mut counts = Vec::new();
+    for request in requests {
+        counts.push(request.await??);
+    }
+    counts.sort_unstable();
+    assert_eq!(
+        counts,
+        vec![1, 2, 3, 4, 5, 6],
+        "every queued request is served"
+    );
+
+    Ok(())
+}
+
+/// `request`, with its component mounting `host_path` read-write.
+fn mounting(
+    mut request: wash_runtime::types::WorkloadStartRequest,
+    host_path: &std::path::Path,
+) -> wash_runtime::types::WorkloadStartRequest {
+    use wash_runtime::types::{HostPathVolume, Volume, VolumeMount, VolumeType};
+    request.workload.volumes.push(Volume {
+        name: "data".to_string(),
+        volume_type: VolumeType::HostPath(HostPathVolume {
+            local_path: host_path.to_string_lossy().into_owned(),
+        }),
+    });
+    for component in &mut request.workload.components {
+        component.local_resources.volume_mounts.push(VolumeMount {
+            name: "data".to_string(),
+            mount_path: "/data".to_string(),
+            read_only: false,
+        });
+    }
+    request
+}
+
+async fn served(client: &reqwest::Client, addr: std::net::SocketAddr, host: &str) -> Result<u64> {
+    let response = client
+        .get(format!("http://{addr}/"))
+        .header("HOST", host)
+        .send()
+        .await?;
+    anyhow::ensure!(response.status().is_success(), "{}", response.status());
+    Ok(json_u64_field(&response.text().await?, "served"))
+}
+
+/// Two revisions of a workload whose exclusive component mounts the same host
+/// directory are two workloads on one host, as during a `Recreate` rollout
+/// (#152). The new revision's first request waits while the old revision's
+/// warm instance holds the directory, and is served by an instance of its own
+/// once the old revision is stopped. (A p3 guest, so that the old revision
+/// keeps a warm instance between requests; the p2 path drops its store after
+/// each one.)
+#[tokio::test]
+async fn a_new_revision_waits_for_the_old_one_on_the_same_host_path() -> Result<()> {
+    // Routed by Host header, so each revision is reached on its own name.
+    let (addr, host) = start_host_with_dynamic_router("127.0.0.1:0").await?;
+    let dir = tempfile::tempdir()?;
+
+    let revision = |name: &str| {
+        let mut request = component_workload_request(
+            "sleeper",
+            name,
+            HTTP_SLEEPER_WASM,
+            resources(true),
+            http_only_host_interfaces(name),
+        );
+        request.workload.components[0].max_invocations = 0;
+        mounting(request, dir.path())
+    };
+    let old = revision("rev1");
+    let old_id = old.workload_id.clone();
+    for request in [old, revision("rev2")] {
+        let status = host.workload_start(request).await?.workload_status;
+        anyhow::ensure!(
+            status.workload_state == wash_runtime::types::WorkloadState::Running,
+            "{status:?}"
+        );
+    }
+
+    let client = reqwest::Client::new();
+    // The old revision serves, and keeps its instance warm.
+    assert_eq!(served(&client, addr, "rev1").await?, 1);
+
+    let first = {
+        let client = client.clone();
+        tokio::spawn(async move { served(&client, addr, "rev2").await })
+    };
+    tokio::time::sleep(Duration::from_millis(500)).await;
+    assert!(
+        !first.is_finished(),
+        "the new revision was served while the old one held the directory"
+    );
+
+    host.workload_stop(wash_runtime::types::WorkloadStopRequest {
+        workload_id: old_id,
+    })
+    .await?;
+    let count = timeout(Duration::from_secs(60), first).await???;
+    assert_eq!(count, 1, "served by the new revision's own instance");
+    Ok(())
+}
