+/// `config` key naming a file that holds the NATS user name for the entry's
+/// connection. Must be set together with [`PASSWORD_FILE_CONFIG_KEY`].
+const USER_FILE_CONFIG_KEY: &str = "user_file";
+
+/// `config` key naming a file that holds the NATS password for the entry's
+/// connection. Must be set together with [`USER_FILE_CONFIG_KEY`].
+const PASSWORD_FILE_CONFIG_KEY: &str = "password_file";
+
+/// How a NATS blobstore entry authenticates, parsed from its `config`.
+#[derive(Debug, Clone, PartialEq, Eq)]
+enum NatsAuth {
+    /// No credential keys: connect from the url alone, as stock wash does.
+    Anonymous,
+    /// User and password, each read from its own file when connecting.
+    UserPasswordFiles {
+        user_file: PathBuf,
+        password_file: PathBuf,
+    },
+}
+
+impl NatsAuth {
+    /// Parse the credential keys of an entry's `config`. Neither key set means
+    /// [`NatsAuth::Anonymous`]; both set to absolute paths means
+    /// [`NatsAuth::UserPasswordFiles`]. One key without the other, an empty
+    /// value or a relative path is an error.
+    fn from_config(config: &HashMap<String, String>) -> anyhow::Result<Self> {
+        let user_file = config.get(USER_FILE_CONFIG_KEY);
+        let password_file = config.get(PASSWORD_FILE_CONFIG_KEY);
+        match (user_file, password_file) {
+            (None, None) => Ok(Self::Anonymous),
+            (Some(user_file), Some(password_file)) => Ok(Self::UserPasswordFiles {
+                user_file: credential_path(USER_FILE_CONFIG_KEY, user_file)?,
+                password_file: credential_path(PASSWORD_FILE_CONFIG_KEY, password_file)?,
+            }),
+            (Some(_), None) | (None, Some(_)) => anyhow::bail!(
+                "nats blobstore backend requires both '{USER_FILE_CONFIG_KEY}' and \
+                 '{PASSWORD_FILE_CONFIG_KEY}' when either is set"
+            ),
+        }
+    }
+
+    /// The part of the pool key that tells this entry's credentials apart:
+    /// empty for [`NatsAuth::Anonymous`], so an entry without credentials keeps
+    /// stock wash's url-only key.
+    fn pool_key_suffix(&self) -> String {
+        match self {
+            Self::Anonymous => String::new(),
+            Self::UserPasswordFiles {
+                user_file,
+                password_file,
+            } => format!(
+                "\u{0}{USER_FILE_CONFIG_KEY}={}\u{0}{PASSWORD_FILE_CONFIG_KEY}={}",
+                user_file.display(),
+                password_file.display()
+            ),
+        }
+    }
+
+    /// Build the connect options, reading any credential files now.
+    /// [`NatsAuth::Anonymous`] yields `ConnectOptions::default()`, which is
+    /// exactly what `async_nats::connect` uses.
+    async fn connect_options(&self) -> anyhow::Result<async_nats::ConnectOptions> {
+        match self {
+            Self::Anonymous => Ok(async_nats::ConnectOptions::default()),
+            Self::UserPasswordFiles {
+                user_file,
+                password_file,
+            } => {
+                let user = read_credential(USER_FILE_CONFIG_KEY, user_file).await?;
+                let password = read_credential(PASSWORD_FILE_CONFIG_KEY, password_file).await?;
+                Ok(async_nats::ConnectOptions::with_user_and_password(
+                    user, password,
+                ))
+            }
+        }
+    }
+}
+
+/// Validate a credential file path from `config`: non-empty and absolute, so
+/// it does not depend on the host's working directory.
+fn credential_path(key: &str, value: &str) -> anyhow::Result<PathBuf> {
+    anyhow::ensure!(
+        !value.is_empty(),
+        "nats blobstore backend '{key}' must not be empty"
+    );
+    let path = PathBuf::from(value);
+    anyhow::ensure!(
+        path.is_absolute(),
+        "nats blobstore backend '{key}' must be an absolute path, got '{value}'"
+    );
+    Ok(path)
+}
+
+/// Read one credential from `path`. One trailing line ending (`\n` or `\r\n`)
+/// is dropped, so a file written with `echo` works; anything else is kept as
+/// is. Errors name the key and the path but never the file's contents.
+async fn read_credential(key: &str, path: &Path) -> anyhow::Result<String> {
+    let mut value = tokio::fs::read_to_string(path).await.map_err(|e| {
+        anyhow::anyhow!(
+            "nats blobstore backend could not read '{key}' {}: {e}",
+            path.display()
+        )
+    })?;
+    if value.ends_with('\n') {
+        value.pop();
+        if value.ends_with('\r') {
+            value.pop();
+        }
+    }
+    anyhow::ensure!(
+        !value.is_empty(),
+        "nats blobstore backend '{key}' {} is empty",
+        path.display()
+    );
+    Ok(value)
+}
