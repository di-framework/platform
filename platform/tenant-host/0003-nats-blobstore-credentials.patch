+    fn credential_files(user: &str, password: &str) -> (tempfile::TempDir, String, String) {
+        let dir = tempfile::tempdir().expect("create a temporary directory");
+        let user_file = dir.path().join("username");
+        let password_file = dir.path().join("password");
+        std::fs::write(&user_file, user).expect("write the user file");
+        std::fs::write(&password_file, password).expect("write the password file");
+        (
+            dir,
+            user_file.display().to_string(),
+            password_file.display().to_string(),
+        )
+    }
