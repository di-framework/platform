+/// Requires `config.url` (e.g. `nats://127.0.0.1:4222`); optionally
+/// `config.user_file` and `config.password_file` (see the module docs). Pooled
+/// by url and credential files, so interfaces sharing a server and credentials
+/// share one connection.
 #[derive(Default)]
 pub struct NatsBlobProvider;
 
 #[async_trait::async_trait]
 impl BackendProvider<BlobId> for NatsBlobProvider {
     fn pool_key(&self, config: &HashMap<String, String>) -> Option<String> {
-        config.get("url").cloned()
+        let url = config.get("url")?;
+        // An entry with invalid credential keys is never pooled, so it reaches
+        // `instantiate` and fails there instead of resolving to a connection
+        // pooled for another entry with the same url.
+        let auth = NatsAuth::from_config(config).ok()?;
+        Some(format!("{url}{}", auth.pool_key_suffix()))
     }
 
     fn backend_type(&self) -> &'static str {
@@ -221,10 +359,284 @@ impl BackendProvider<BlobId> for NatsBlobProvider {
         let url = config
             .get("url")
             .ok_or_else(|| anyhow::anyhow!("nats blobstore backend requires a 'url' config"))?;
-        let client = async_nats::connect(url).await?;
+        let options = NatsAuth::from_config(config)?.connect_options().await?;
+        let client = options.connect(url.as_str()).await?;
         let context = async_nats::jetstream::new(client);
         Ok(Arc::new(NatsBlobBackend {
             context: Arc::new(context),
         }))
     }
 }
