+        let backend = NatsBlobProvider.instantiate(&config).await;
+        let connect = server.await.unwrap();
+        assert!(backend.is_ok(), "{:?}", backend.err());
+        assert_eq!(connect["user"], "registry");
+        assert_eq!(connect["pass"], "s3cr3t");
+    }
