+        let (_dir, user_file, password_file) = credential_files("registry\n", "s3cr3t\n");
+        let (url, server) = fake_nats_server().await;
+        let config = config(&[
+            ("backend", "nats"),
+            (URL_KEY, &url),
+            (USER_FILE_CONFIG_KEY, &user_file),
+            (PASSWORD_FILE_CONFIG_KEY, &password_file),
