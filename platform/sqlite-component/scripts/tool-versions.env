# Pinned toolchain for the di-framework:sqlite component.
#
# Every binary that `scripts/install-tools.sh` downloads is verified against
# the SHA-256 recorded here before it is unpacked or executed. Checksums were
# computed from the official release assets on 2026-09-09; a mismatch aborts
# the install. To upgrade a tool: bump the version, download the new assets,
# recompute the hashes (`shasum -a 256`), and update this file in the same
# commit.
#
# Format: plain `KEY=VALUE`, sourceable by POSIX sh.

# --- Rust -------------------------------------------------------------------
RUST_TOOLCHAIN=1.97.1
RUST_TARGET=wasm32-wasip2
# rustup-init is only used when no `rustup` is on PATH (hermetic install into
# .tools/). Upstream publishes these hashes at
# https://static.rust-lang.org/rustup/archive/<ver>/<triple>/rustup-init.sha256
RUSTUP_VERSION=1.29.1
RUSTUP_INIT_SHA256_aarch64_apple_darwin=ec1b9233e7f72990ecd8e62063fa7f6c3dfc2bec8e97f88bff165f9100ac696a
RUSTUP_INIT_SHA256_x86_64_apple_darwin=259e2b84274434085163fe8d556510571772cda2aa6d87ca6aa664f57bc644e3
RUSTUP_INIT_SHA256_x86_64_unknown_linux_gnu=dda7234360b7f578ca8b0ddcb80145646fa61a67c1720a5abc7051b35c9fcb71
RUSTUP_INIT_SHA256_aarch64_unknown_linux_gnu=15f6e4ce9f583b929c996c91562bad6d4454f3281de858b02cdfdef615fac433

# --- Rust crates (also pinned with `=` in Cargo.toml / Cargo.lock) ----------
RUSQLITE_VERSION=0.40.2
LIBSQLITE3_SYS_VERSION=0.38.2
SQLITE_AMALGAMATION_VERSION=3.53.2
WIT_BINDGEN_VERSION=0.61.1

# --- wasi-sdk (clang + wasi-libc headers for compiling sqlite3.c) -----------
# https://github.com/WebAssembly/wasi-sdk/releases/tag/wasi-sdk-34
WASI_SDK_VERSION=34.0
WASI_SDK_TAG=wasi-sdk-34
WASI_SDK_SHA256_arm64_macos=9c59398106b417f8f14913380fdf0097a8cc0ff4af9eb3ce0065a859e88d49e9
WASI_SDK_SHA256_x86_64_macos=87d27fa8adc68dee59bfbf2e22a6d34ef717c34d6bf1d8af2a56fc929d9ce0eb
WASI_SDK_SHA256_x86_64_linux=b761e3a0721dbae9c09a0059e5fdb2bf917d1b4a8a7b430fb3b5aafb0984b2c4
WASI_SDK_SHA256_arm64_linux=f7e243dff54d60bcc576e94d6166b69f410f2500ae4a9ceef34315be10e77971

# --- wasm-tools (validate / inspect / print WIT) ---------------------------
# https://github.com/bytecodealliance/wasm-tools/releases/tag/v1.258.0
WASM_TOOLS_VERSION=1.258.0
WASM_TOOLS_SHA256_aarch64_macos=64370d279234669fca407383fae96ce518c6628e0a4ab186dba590f8678c3646
WASM_TOOLS_SHA256_x86_64_macos=10621ef8537d9c37d1c3e4e6199ab6b0d4d2bf4862eb6815c4a4d4ebaec2db38
WASM_TOOLS_SHA256_x86_64_linux=b52d14eb74a4852cc249369bd4480c2b2fdd876145f41db51ff52269ded240ce
WASM_TOOLS_SHA256_aarch64_linux=86714f59d76218c22a1aa7e14bdc19e22facaec5c4a12a1f0be2f1594ce1ad26

# --- wac (WebAssembly Composition: plugs the JS component into this one) ---
# https://github.com/bytecodealliance/wac/releases/tag/v0.11.0
WAC_VERSION=0.11.0
WAC_SHA256_aarch64_apple_darwin=eb52621a3dd35ae5bd0746d95b766dcb0d6c0b64c934c30c69dc2bc41f7db562
WAC_SHA256_x86_64_apple_darwin=9214250bdc5e4c02b046bcdb72bfd1602366b6b92a81c212fbdcf064621c8fc6
